{
  "name": "opencode-bls",
  "displayName": "OpenCode BLS",
  "description": "Optimized OpenCode extension for VS Code with native OpenCode v2.x support",
  "version": "1.0.0",
  "publisher": "panchove",
  "repository": {
    "type": "git",
    "url": "https://github.com/panchove/opencode-bls"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#131010",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "assistant",
    "copilot",
    "agent"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencode.openTerminal",
        "title": "OpenCode: Open or Focus Terminal",
        "icon": {
          "light": "images/button-light.svg",
          "dark": "images/button-dark.svg"
        }
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "OpenCode: Open New Terminal Tab",
        "icon": {
          "light": "images/button-light.svg",
          "dark": "images/button-dark.svg"
        }
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "OpenCode: Insert File/Line Reference (@file#L...)"
      },
      {
        "command": "opencode.sendSelectionToTerminal",
        "title": "OpenCode: Send Code Selection to Terminal"
      },
      {
        "command": "opencode.openWebUI",
        "title": "OpenCode: Open Web UI (v2 Dashboard)"
      },
      {
        "command": "opencode.startService",
        "title": "OpenCode: Start Background Daemon Service"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openTerminal",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "opencode.addFilepathToTerminal",
          "group": "opencode@1"
        },
        {
          "command": "opencode.sendSelectionToTerminal",
          "group": "opencode@2",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.openTerminal",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+k",
        "linux": "ctrl+alt+k"
      },
      {
        "command": "opencode.sendSelectionToTerminal",
        "key": "cmd+alt+l",
        "mac": "cmd+alt+l",
        "win": "ctrl+alt+l",
        "linux": "ctrl+alt+l",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "OpenCode BLS",
      "properties": {
        "opencode.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the opencode executable. If empty, it searches automatically in PATH and ~/.opencode/bin/opencode."
        },
        "opencode.terminalLocation": {
          "type": "string",
          "enum": [
            "beside",
            "panel"
          ],
          "default": "beside",
          "description": "Location where the OpenCode terminal opens ('beside' for split editor, 'panel' for bottom panel)."
        },
        "opencode.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to the OpenCode CLI when launching the terminal (e.g. ['--auto'])."
        },
        "opencode.webUrl": {
          "type": "string",
          "default": "",
          "description": "Custom URL for the OpenCode web interface. If empty, it queries automatically using 'opencode service status'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "build:vsix": "npm run package && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
